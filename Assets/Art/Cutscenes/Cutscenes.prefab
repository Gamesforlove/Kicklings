    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 0
    characterIndex: 0
    dialogueText: Maybe you'll even be almost as good as me someday.
