    scaleDuration: 0.3
  - type: 0
    characterIndex: 0
    dialogueText: You've got spirit. Let's see how far you go.
    moveTarget: {x: 0, y: 0, z: 0}
    moveDuration: 0.6
    newSprite: {fileID: 0}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 0
    characterIndex: 1
    dialogueText: Thanks, Grandpa! Thank you so much for teaching me!
    moveTarget: {x: 0, y: 0, z: 0}
    moveDuration: 0.6
    newSprite: {fileID: 0}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 0
    characterIndex: 0
    dialogueText: You did great out there. I can't wait to see what you'll achieve.
    moveTarget: {x: 0, y: 0, z: 0}
    moveDuration: 0.6
    newSprite: {fileID: 0}
    waitSeconds: 0.5
    animationName: 
