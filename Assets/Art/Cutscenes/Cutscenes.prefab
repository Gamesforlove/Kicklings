  tmpText: {fileID: 5020982886362821058}
  charsPerSecond: 20
  sequence:
  - type: 4
    characterIndex: 0
    dialogueText: You've got spirit. Let's see how far you go.
    moveTarget: {x: 0, y: 0, z: 0}
    moveDuration: 0.6
    newSprite: {fileID: 21300000, guid: 26926083e414fa64281b0cd2d8347443, type: 3}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 3
    characterIndex: 3
    dialogueText: You've got spirit. Let's see how far you go.
    moveTarget: {x: 0, y: 0, z: 0}
    moveDuration: 0.6
    newSprite: {fileID: 21300000, guid: 26926083e414fa64281b0cd2d8347443, type: 3}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 1
    characterIndex: 3
    dialogueText: "And if you happen to beat me again, then maybe I\u2019ll think
      you\u2019ll be cool"
    moveTarget: {x: -15, y: -4, z: 0}
    moveDuration: 0.1
    newSprite: {fileID: -113773828, guid: 18d529a254eed8a44938d87989468275, type: 3}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 4
    characterIndex: 1
    dialogueText: "Ugh\u2014no way! How did you get so good?"
    moveTarget: {x: 0, y: 0, z: 0}
    moveDuration: 0.6
    newSprite: {fileID: 4966897614379924022, guid: 16b4361df5abc2a4abd0ec492f8d9d1a, type: 3}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 0
    characterIndex: 1
    dialogueText: Ugh, you're back here again? Really? Laammeee
    moveTarget: {x: 0, y: 0, z: 0}
    moveDuration: 0.6
    newSprite: {fileID: 1641077559, guid: 18d529a254eed8a44938d87989468275, type: 3}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 8
    characterIndex: 2
    dialogueText: You're on!
    moveTarget: {x: -3, y: -4, z: 0}
    moveDuration: 0.1
    newSprite: {fileID: -697165553, guid: e02399208f09fc94fa2ddcfe1fdb7a63, type: 3}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 4
    characterIndex: 2
    dialogueText: "Don\u2019t think this means anything! I\u2019m still the best
      around."
    moveTarget: {x: 0, y: 0, z: 0}
    moveDuration: 0.6
    newSprite: {fileID: 1291047107, guid: e02399208f09fc94fa2ddcfe1fdb7a63, type: 3}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 0
    characterIndex: 2
    dialogueText: "That's right! I want to show you I\u2019m not a wimp!"
    moveTarget: {x: 0, y: 0, z: 0}
    moveDuration: 0.6
    newSprite: {fileID: -1669010786, guid: e02399208f09fc94fa2ddcfe1fdb7a63, type: 3}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 8
    characterIndex: 2
    dialogueText: You're on!
    moveTarget: {x: -3, y: -4, z: 0}
    moveDuration: 0.1
    newSprite: {fileID: -697165553, guid: e02399208f09fc94fa2ddcfe1fdb7a63, type: 3}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 4
    characterIndex: 2
    dialogueText: You're on!
    moveTarget: {x: -3, y: -4, z: 0}
    moveDuration: 0.1
    newSprite: {fileID: -697165553, guid: e02399208f09fc94fa2ddcfe1fdb7a63, type: 3}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 4
    characterIndex: 1
    dialogueText: Do you want to be friends?
    moveTarget: {x: 0, y: 0, z: 0}
    moveDuration: 0.6
    newSprite: {fileID: 4223633054461446407, guid: 16b4361df5abc2a4abd0ec492f8d9d1a, type: 3}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 0
    characterIndex: 1
    dialogueText: Whatever, this time if I win, you have to call me the super epic
      winner and I'm the best ever.
    moveTarget: {x: -3, y: -4, z: 0}
    moveDuration: 0.1
    newSprite: {fileID: -1045015865, guid: 18d529a254eed8a44938d87989468275, type: 3}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 0
    characterIndex: 2
    dialogueText: And if I win, you have to stop being so mean
    moveTarget: {x: -3, y: -4, z: 0}
    moveDuration: 0.1
    newSprite: {fileID: -697165553, guid: e02399208f09fc94fa2ddcfe1fdb7a63, type: 3}
