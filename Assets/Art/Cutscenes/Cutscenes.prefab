    moveDuration: 0.6
    newSprite: {fileID: 0}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 0
    characterIndex: 1
    dialogueText: Almost? I'm gonna beat you one day!
    moveTarget: {x: 0, y: 0, z: 0}
    moveDuration: 0.6
    newSprite: {fileID: 0}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 0
    characterIndex: 0
