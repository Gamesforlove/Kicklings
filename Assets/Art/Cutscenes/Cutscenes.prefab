  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bd04d298104e9f740941a387c9c58106, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characters:
  - {fileID: 5535021599889525635}
  - {fileID: 3587387289433979521}
  - {fileID: 7954483739895624616}
  - {fileID: 2278381449063127675}
  dialogBox: {fileID: 6385292978113132791}
  doneIcon: {fileID: 1011600928687279327}
  arrowUI: {fileID: 8099317359625886913}
  arrowIsUI: 0
  arrowYOffset: 80
  arrowWorldY: -1.48
  tmpText: {fileID: 5020982886362821058}
  charsPerSecond: 20
  sequence:
  - type: 4
    characterIndex: 0
    dialogueText: You've got spirit. Let's see how far you go.
    moveTarget: {x: 0, y: 0, z: 0}
    moveDuration: 0.6
    newSprite: {fileID: 21300000, guid: 221d5233fc8c5974cab9a6413c9da2ce, type: 3}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 3
    characterIndex: 3
    dialogueText: You've got spirit. Let's see how far you go.
    moveTarget: {x: 0, y: 0, z: 0}
    moveDuration: 0.6
    newSprite: {fileID: 21300000, guid: 26926083e414fa64281b0cd2d8347443, type: 3}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 4
    characterIndex: 1
    dialogueText: You've got spirit. Let's see how far you go.
    moveTarget: {x: 0, y: 0, z: 0}
    moveDuration: 0.6
    newSprite: {fileID: 4966897614379924022, guid: 16b4361df5abc2a4abd0ec492f8d9d1a, type: 3}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 1
    characterIndex: 3
    dialogueText: "And if you happen to beat me again, then maybe I\u2019ll think
      you\u2019ll be cool"
    moveTarget: {x: -15, y: -4, z: 0}
    moveDuration: 0.1
    newSprite: {fileID: -113773828, guid: 18d529a254eed8a44938d87989468275, type: 3}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 0
    characterIndex: 1
    dialogueText: Nice playing with you again.
    moveTarget: {x: 0, y: 0, z: 0}
    moveDuration: 0.6
    newSprite: {fileID: 1641077559, guid: 18d529a254eed8a44938d87989468275, type: 3}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 0
    characterIndex: 1
    dialogueText: "We didn\u2019t really get to be on the field together much when
      we were younger. You did great in junior high."
    moveTarget: {x: 0, y: 0, z: 0}
    moveDuration: 0.6
    newSprite: {fileID: 1641077559, guid: 18d529a254eed8a44938d87989468275, type: 3}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 0
    characterIndex: 2
    dialogueText: Thanks! You were good too. I guess the coach just thought I worked
      better with my buddy.
    moveTarget: {x: 0, y: 0, z: 0}
    moveDuration: 0.6
    newSprite: {fileID: 1641077559, guid: 18d529a254eed8a44938d87989468275, type: 3}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 4
    characterIndex: 1
    dialogueText: Thanks! You were good too. I guess the coach just thought I worked
      better with my buddy.
    moveTarget: {x: 0, y: 0, z: 0}
    moveDuration: 0.6
    newSprite: {fileID: 4223633054461446407, guid: 16b4361df5abc2a4abd0ec492f8d9d1a, type: 3}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 0
    characterIndex: 1
    dialogueText: "Yeah, that\u2019s just how it goes sometimes."
    moveTarget: {x: 0, y: 0, z: 0}
    moveDuration: 0.6
    newSprite: {fileID: 1641077559, guid: 18d529a254eed8a44938d87989468275, type: 3}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 0
    characterIndex: 1
    dialogueText: 'Still wish I got more play time, though. But whatever, you made
      your plays count. '
    moveTarget: {x: 0, y: 0, z: 0}
    moveDuration: 0.6
    newSprite: {fileID: 1641077559, guid: 18d529a254eed8a44938d87989468275, type: 3}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 0
    characterIndex: 2
    dialogueText: What was that at the end?...
    moveTarget: {x: 0, y: 0, z: 0}
    moveDuration: 0.6
    newSprite: {fileID: 1641077559, guid: 18d529a254eed8a44938d87989468275, type: 3}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 4
    characterIndex: 1
    dialogueText: What was that at the end?...
    moveTarget: {x: 0, y: 0, z: 0}
    moveDuration: 0.6
    newSprite: {fileID: 582226495460360136, guid: 16b4361df5abc2a4abd0ec492f8d9d1a, type: 3}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 0
    characterIndex: 1
    dialogueText: "I SAID YOU\u2019RE GOOD, OKAY?!"
    moveTarget: {x: 0, y: 0, z: 0}
    moveDuration: 0.6
    newSprite: {fileID: 1641077559, guid: 18d529a254eed8a44938d87989468275, type: 3}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 4
    characterIndex: 1
    dialogueText: "I SAID YOU\u2019RE GOOD, OKAY?!"
    moveTarget: {x: 0, y: 0, z: 0}
    moveDuration: 0.6
    newSprite: {fileID: 4966897614379924022, guid: 16b4361df5abc2a4abd0ec492f8d9d1a, type: 3}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 0
    characterIndex: 1
    dialogueText: "Don\u2019t make me repeat it!"
    moveTarget: {x: 0, y: 0, z: 0}
    moveDuration: 0.6
    newSprite: {fileID: 1641077559, guid: 18d529a254eed8a44938d87989468275, type: 3}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 0
    characterIndex: 2
    dialogueText: "Heh, thanks! Well, now that we\u2019re both here\u2014wanna get
      some extra practice in?"
    moveTarget: {x: 0, y: 0, z: 0}
    moveDuration: 0.6
    newSprite: {fileID: 1641077559, guid: 18d529a254eed8a44938d87989468275, type: 3}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
  - type: 0
    characterIndex: 1
    dialogueText: "Heh, I know I\u2019m confident in my skills. The question is\u2014are
      you?"
    moveTarget: {x: 0, y: 0, z: 0}
    moveDuration: 0.6
    newSprite: {fileID: 1641077559, guid: 18d529a254eed8a44938d87989468275, type: 3}
    waitSeconds: 0.5
    animationName: 
    flipX: 1
    flipY: 0
    targetScale: {x: 1, y: 1, z: 1}
    scaleDuration: 0.3
